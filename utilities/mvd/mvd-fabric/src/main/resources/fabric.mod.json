{
  "schemaVersion": 1,
  "id": "mvd",
  "version": "${version}",
  "name": "Minecraft Version Detector",
  "description": "Detects the running Minecraft version for other mods.",
  "authors": ["CebbyS"],
  "contact": {
    "sources": "https://github.com/CebbysMods/modularity"
  },
  "license": "CC0-1.0",
  "icon": "assets/mvd/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["lv.cebbys.mcmods.mvd.fabric.MvdFabric"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=21"
  }
}
