{
  "schemaVersion": 1,
  "id": "mpd",
  "version": "${version}",
  "name": "Minecraft Platform Detector",
  "description": "Detects the running mod loader (Fabric, Quilt, NeoForge, Forge) for other mods.",
  "authors": ["CebbyS"],
  "contact": {
    "sources": "https://github.com/CebbysMods/modularity"
  },
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": ["lv.cebbys.mcmods.mpd.fabric.MpdFabric"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=21"
  }
}
