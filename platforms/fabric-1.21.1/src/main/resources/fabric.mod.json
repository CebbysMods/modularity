{
  "schemaVersion": 1,
  "id": "modularity",
  "version": "${version}",
  "name": "Modularity",
  "description": "Multi version, multi loader modding API. Fabric ${minecraft_version} platform.",
  "authors": ["CebbyS"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["lv.cebbys.mcmods.modularity.fabric.ModularityFabric"],
    "client": ["lv.cebbys.mcmods.modularity.fabric.client.ModularityFabricClient"],
    "server": ["lv.cebbys.mcmods.modularity.fabric.ModularityFabricServer"]
  },
  "mixins": ["modularity.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "mvd": ">=4.0.0",
    "mpd": ">=1.0.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=21"
  }
}
